# ─── Supabase ────────────────────────────────────────────────────────────────
# Client anonyme (exposé au navigateur — insert/update RLS anon uniquement)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Service role (serveur uniquement — webhook Notion + envoi email)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ─── Resend (email transactionnel) ───────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM="Vanys Weddings <audit@vanysweddings.com>"

# ─── Notion (CRM Prospects — Toutes Marques) ─────────────────────────────────
NOTION_API_KEY=secret_xxxxxxxxxxxx
NOTION_CRM_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Cron (séquence email J+2 → J+9) ─────────────────────────────────────────
# Protège /api/cron/sequence. Vercel Cron envoie automatiquement
# « Authorization: Bearer $CRON_SECRET » quand cette variable est définie.
CRON_SECRET=change-me-long-random-string
